[Desktop Entry]
Type=Application
Name=InDuckGo
GenericName=Web Browser
GenericName[pl]=Przeglądarka WWW
Comment=Browse the web with DuckDuckGo's open-source tracker protections
Comment[pl]=Przeglądaj internet z otwartą ochroną przed śledzeniem DuckDuckGo
Exec=induckgo %U
Icon=io.github.induckgo.InDuckGo
Terminal=false
StartupNotify=true
StartupWMClass=io.github.induckgo.InDuckGo
Categories=Network;WebBrowser;GTK;
Keywords=web;browser;internet;privacy;tracker;duckduckgo;
Keywords[pl]=www;przeglądarka;internet;prywatność;śledzenie;duckduckgo;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
